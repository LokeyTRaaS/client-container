FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the operator binary
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /app/operator ./cmd/operator

# Runtime stage
FROM gcr.io/distroless/static:nonroot

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/operator /app/operator

# Use nonroot user (distroless provides this)
USER nonroot:nonroot

# Run the operator
ENTRYPOINT ["/app/operator"]
